@Metadata.layer: #CORE

@UI: {
  headerInfo: {
    typeName: 'Incident',
    typeNamePlural: 'Incidents',
    title: {
      type: #STANDARD,
      value: 'IncidentId'
    }
  },
  presentationVariant: [{
    sortOrder: [{
      by: 'IncidentId',
      direction: #ASC
    }],
    visualizations: [{
      type: #AS_LINEITEM
    }]
  }]
}

annotate entity ZC_INCT_615 with
{

  @UI.facet: [
    {
      id: 'IncidentHeader',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Incident Details',
      position: 10
    },
    {
      id: 'HistoryList',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Incident History',
      position: 20,
      targetElement: '_History'
    }
  ]

  @UI.hidden: true
  
  @UI.lineItem: [
    { type: #FOR_ACTION, 
      dataAction: 'changeStatus', 
      label: 'Change Status', 
      position: 10, 
      importance: #HIGH } ]
      
  @UI.identification: [
    { type: #FOR_ACTION, 
      dataAction: 'changeStatus', 
      label: 'Change Status', 
      position: 10, 
      importance: #HIGH } ]
  IncUuid;
---------------------------------------------------------------------------------------------------------------------------------
