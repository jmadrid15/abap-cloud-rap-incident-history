projection;
strict ( 2 );
use draft;

define behavior for ZC_INCT_615 alias Incident
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action changeStatus;

  use association _History { with draft; }
}

define behavior for ZC_INCT_H_615 alias History
{

  use association _Incident { with draft; }
}