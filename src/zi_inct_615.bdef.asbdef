managed implementation in class zbp_i_inct_615 unique;
strict ( 2 );
with draft;

define behavior for ZI_INCT_615 alias Incident
persistent table zdt_inct_615
draft table zdt_inct_615_d
lock master
total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( global, instance )
with additional save
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) IncUuid;

  field ( readonly ) IncidentId,
  Status,
  ChangedDate,
  CreationDate,
  LastChangedAt,
  LocalCreatedAt,
  LocalCreatedBy,
  LocalLastChangedAt,
  LocalLastChangedBy;

  field ( mandatory ) Title,
  Description,
  Priority;

  action ( features : instance, authorization : update ) changeStatus
    parameter ZA_CHANGE_STATUS_615 result [1] $self;

  validation validateMandatoryFields on save { create; update; field Title, Description, Priority; }
  validation validateDateRange on save { create; update; field CreationDate, ChangedDate; }


  determination setInitialHistory on save { create; }
  determination setInitialValues on modify { create; }
  determination setChangedDate on modify { create; field Title, Description, Status, Priority; }

  side effects
  {
    action changeStatus affects entity _History;

  }


  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  draft determine action Prepare
  {
    validation validateMandatoryFields;
    validation validateDateRange;
  }

  mapping for zdt_inct_615
    {
      IncUuid            = inc_uuid;
      IncidentId         = incident_id;
      Title              = title;
      Description        = description;
      Status             = status;
      Priority           = priority;
      CreationDate       = creation_date;
      ChangedDate        = changed_date;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }


  association _History { create ( features : instance ); with draft; }



}

define behavior for ZI_INCT_H_615 alias History
persistent table zdt_inct_h_615
draft table zdt_inct_h_615_d
lock dependent by _Incident
authorization dependent by _Incident
etag master LocalLastChangedAt
{

  update;
  delete;

  field ( numbering : managed, readonly ) HisUuid;

  field ( readonly ) IncUuid,
  LastChangedAt,
  LocalCreatedAt,
  LocalCreatedBy,
  LocalLastChangedAt,
  LocalLastChangedBy;

  mapping for zdt_inct_h_615
    {
      HisUuid            = his_uuid;
      IncUuid            = inc_uuid;
      HisId              = his_id;
      PreviousStatus     = previous_status;
      NewStatus          = new_status;
      Text               = text;
      LocalCreatedBy     = local_created_by;
      LocalCreatedAt     = local_created_at;
      LocalLastChangedBy = local_last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
      LastChangedAt      = last_changed_at;
    }

  association _Incident { with draft; }
}